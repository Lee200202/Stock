/**
 * 是不是外國股票。
 * 名稱若能精確對上台股官方簡稱，一律以台股為準——像三星在台灣有掛牌（5007），
 * 所以名單裡放的是三星電子而不是三星，這裡再確認一次，未來出現撞名也不會誤刪。
 */
function pipeIsForeign_(name, byName) {
  var n = String(name || '').trim();
  if (!n) { return false; }
  if (byName && byName[n]) { return false; }
  if (PIPE_FOREIGN_STOCKS.indexOf(n) >= 0) { return true; }
  var stem = n.replace(/(ADR|公司|股價|集團)$/, '').trim();
  return stem && stem !== n && PIPE_FOREIGN_STOCKS.indexOf(stem) >= 0;
}

/** 是不是根本不是個股。回傳原因字串，空字串代表是個股。 */
function pipeNonStockReason_(name) {
  var n = String(name || '').replace(/\s+/g, '').replace(/載版/g, '載板');
  if (!n) { return '空白'; }
  if (PIPE_NON_STOCK_EXACT.indexOf(n) >= 0) { return '指數或族群泛稱'; }
  for (var i = 0; i < PIPE_NON_STOCK_SUFFIX.length; i++) {
    if (n.slice(-PIPE_NON_STOCK_SUFFIX[i].length) === PIPE_NON_STOCK_SUFFIX[i]) {
      return '以「' + PIPE_NON_STOCK_SUFFIX[i] + '」結尾，不是單一個股';
    }
  }
  // 台股沒有一個字的官方簡稱。單字幾乎都是語音切錯留下的碎片，
  // 而單字拿去比相似度很容易湊出虛假高分。
  if (n.length === 1) { return '只有一個字，不是股票簡稱'; }
  if (n.length > 8) { return '過長，不像股票簡稱'; }

  // 用頓號、斜線、加號把兩三個主題串起來的，是講者在談盤面題材不是個股。
  // 實際出現過「低軌衛星加無人機、驅動IC」被當成一檔股票寫進表裡。
  // 台股沒有任何官方簡稱含這些符號。
  if (/[、，,／/+＋]/.test(n)) { return '含連接符號，是多個題材的組合不是個股'; }
  if (/.加./.test(n) && n.length >= 5) { return '用「加」串接多個題材，不是個股'; }

  // 常見的族群與題材用詞。這些是講者用來描述盤面的，不是公司簡稱。
  var THEME = ['低軌衛星', '衛星', '無人機', '驅動IC', '矽光子', '重電', '軍工',
               '散熱', '記憶體', '被動元件', '銅箔基板', '玻纖布', '砷化鎵',
               '高速傳輸', '光通訊', '生技', '航運', '金融', '傳產', '電子',
               '權值', '題材', '概念', '族群', '類股', '產業鏈', '供應鏈'];
  for (var t = 0; t < THEME.length; t++) {
    if (n.indexOf(THEME[t]) >= 0) {
      return '含族群或題材用詞「' + THEME[t] + '」，不是個股';
    }
  }
  // 無中文字的先放行，交給下一關判斷是不是 AES-KY 那種英文名個股。
  return '';
}


/* ------------------------------------------------------------------ *
 * 三、代號解析
 * ------------------------------------------------------------------ */

/** 去掉 -KY、*、投控 這類後綴，讓「譜瑞」對得上「譜瑞-KY」。 */
function pipeBase_(s) {
  return String(s || '').replace(/(-?KY|-?DR|\*|投控|控股)$/, '').trim();
}

/** 英數骨架，大寫去符號。AES-KY → AESKY。 */
function pipeLatin_(s) {
  return String(s || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase();
}

function pipeHasCJK_(s) {
  return /[\u4e00-\u9fff]/.test(String(s || ''));
}

/**
 * 解析一個名稱。回傳 { code, name, how, reject }
 *
 * 順序與 pipeline.py 一致，而且順序本身有意義：
 * 英文名個股要排在非個股剔除之前（否則 AES-KY 會被「無中文字」那條殺掉），
 * 外國股票與非個股要排在相似度比對之前（否則會被硬湊到拼音相近的台股上，
 * 那比留成待確認更糟——資料看起來完全正常，但整列都是錯的）。
 */
function pipeResolveName_(name, map) {
  var n = String(name || '').trim();
  if (!n) { return { reject: true, how: '空白名稱' }; }
  if (['日幣','日圓','日元','美元','美金','台幣','臺幣','新台幣','人民幣','歐元'].indexOf(n) >= 0) { return {reject:true, how:'貨幣，不是股票'}; }
  if (['普威','普位','譜位'].indexOf(n) >= 0) { return {code:'4966', name:'譜瑞-KY', how:'管理者確認名稱'}; }
  if (['戲制台','矽製材','矽智財','細金元','矽晶圓'].indexOf(n) >= 0) {
    return {reject:true, how:'產業名稱，不是個股'};
  }

  var confirmed = PUBLIC_CONFIRMED_NAMES;
  if (confirmed[n]) { return {code:confirmed[n][0],name:confirmed[n][1],how:'已核對的語音名稱'}; }

  // 0. 名稱完全相同
  if (map.byName[n]) {
    return { code: map.byName[n], name: n, how: '名稱完全相同' };
  }

  // 1. 英文名個股（AES-KY、IET-KY、TPK-KY）
  if (!pipeHasCJK_(n)) {
    var lat = pipeLatin_(n);
    if (lat.length >= 2) {
      var bc = '', bs = 0;
      Object.keys(map.byCode).forEach(function (c) {
        var offName = map.byCode[c].name;
        if (pipeHasCJK_(offName)) { return; }
        var nl = pipeLatin_(offName);
        if (!nl) { return; }
        var s = Math.max(similarity_(lat, nl),
                         similarity_(lat.replace(/(KY|DR)$/, ''), nl.replace(/(KY|DR)$/, '')));
        if (s > bs) { bs = s; bc = c; }
      });
      if (bc && bs >= 0.75) {
        return { code: bc, name: map.byCode[bc].name, how: '英文名稱相似 ' + bs.toFixed(2) };
      }
    }
  }

  // 2. 外國股票
  if (pipeIsForeign_(n, map.byName)) {
    return { reject: true, how: '外國股票，不在台股掛牌' };
  }

  // 3. 非個股
  var why = pipeNonStockReason_(n);
  if (why) { return { reject: true, how: why }; }

  // 4. 去後綴後相同（譜瑞 對 譜瑞-KY）
  var nb = pipeBase_(n);
  var hit = '';
  Object.keys(map.byCode).forEach(function (c) {
    if (!hit && pipeBase_(map.byCode[c].name) === nb) { hit = c; }
  });
  if (hit) { return { code: hit, name: map.byCode[hit].name, how: '去後綴後相同' }; }

  // 5. 字面相似
  var bestC = '', bestS = 0, cands = [];
  Object.keys(map.byCode).forEach(function (c) {
    var s = Math.max(similarity_(n, map.byCode[c].name),
                     similarity_(nb, pipeBase_(map.byCode[c].name)));
    if (s > bestS) { bestS = s; bestC = c; }
    if (s >= 0.34) { cands.push({ c: c, n: map.byCode[c].name, s: s }); }
  });
  if (bestS >= 0.8) {
    return { code: bestC, name: map.byCode[bestC].name, how: '字面相似 ' + bestS.toFixed(2) };
  }

  // 6. 交給同音判定。候選按相似度排序後取前 40 個。
  cands.sort(function (a, b) { return b.s - a.s; });
  return { pending: true, name: n, candidates: cands.slice(0, 40),
           how: '待同音判定（最高字面相似 ' + bestS.toFixed(2) + '）' };
}

var PIPE_HOMOPHONE_SYSTEM =
  '你要判斷語音轉文字聽錯的股票名稱，實際上各是哪一檔台股。\n' +
  '\n' +
  '輸入是一份清單，每一項有「聽到的名稱」與它的候選（都是真實的台股簡稱）。\n' +
  '\n' +
  '規則：\n' +
  '1. 每一項只能從它自己的候選裡挑，或回答沒有。\n' +
  '   絕對不可以生一個不在候選裡的代號或名稱。\n' +
  '2. 主要看國語發音是否相同或極近。例如「加哲」就是「嘉澤」，「利望」就是「力旺」，\n' +
  '   「四星」就是「世芯」，「普會」與「普瑞」都是「譜瑞」，「四星KY」是「世芯-KY」。\n' +
  '3. 後綴不影響判斷。「四星KY」「四星科」「四星」都指同一檔，看主體那兩三個字。\n' +
  '4. 字形像但發音差很多的，不算。\n' +
  '5. 聽到的名稱若其實是產業、族群、概念、題材、指數、集團，或是外國公司，\n' +
  '   code 一律回空字串。像「低軌衛星」「無人機」「驅動IC」「矽光子」「重電」\n' +
  '   這些都是族群不是個股。\n' +
  '6. 名稱中間有頓號、加號或「加」把兩三個主題串在一起的（例如\n' +
  '   「低軌衛星加無人機、驅動IC」），那是講者在講盤面題材，不是股票，回空字串。\n' +
  '7. 沒有把握就回空字串。寧可留待確認，也不要配錯——配錯的資料看起來完全正常，\n' +
  '   反而比空著更難被發現。\n' +
  '\n' +
  '只回傳 JSON，順序與輸入相同：\n' +
  '{"results":[{"input":"聽到的名稱","code":"代號或空字串","reason":"20字內理由"}]}';

/** 安全解析模型回傳的 JSON，自動容錯 Markdown 標記、註解、尾隨逗號與未跳脫控制字元 */
function safeParseJson_(raw, fallback) {
  if (!raw) return fallback;
  var text = String(raw).trim();
  text = text.replace(/^```[a-zA-Z0-9_-]*\s*/gm, '').replace(/\s*```$/gm, '').trim();
  try { return JSON.parse(text); } catch (e) {}

  var fb = text.indexOf('{');
  var fbr = text.indexOf('[');
  if (fb !== -1 && (fbr === -1 || fb < fbr)) {
    var lb = text.lastIndexOf('}');
    if (lb !== -1) text = text.substring(fb, lb + 1);
  } else if (fbr !== -1) {
    var lbr = text.lastIndexOf(']');
    if (lbr !== -1) text = text.substring(fbr, lbr + 1);
  }

  var out = [];
  var inString = false;
  var escape = false;
  for (var i = 0; i < text.length; i++) {
    var c = text[i];
    if (inString) {
      if (escape) {
        out.push(c);
        escape = false;
      } else if (c === '\\') {
        out.push(c);
        escape = true;
      } else if (c === '"') {
        out.push(c);
        inString = false;
      } else if (c === '\n') {
        out.push('\\n');
      } else if (c === '\r') {
        // skip
      } else if (c === '\t') {
        out.push('\\t');
      } else {
        out.push(c);
      }
      continue;
    }
    if (c === '"') {
      out.push(c);
      inString = true;
      continue;
    }
    if (c === '/' && i + 1 < text.length && text[i + 1] === '/') {
      i += 2;
      while (i < text.length && text[i] !== '\n' && text[i] !== '\r') i++;
      continue;
    }
    if (c === '/' && i + 1 < text.length && text[i + 1] === '*') {
      i += 2;
      while (i + 1 < text.length && !(text[i] === '*' && text[i + 1] === '/')) i++;
      i++;
      continue;
    }
    if (c === ',') {
      var j = i + 1;
      while (j < text.length && (text[j] === ' ' || text[j] === '\t' || text[j] === '\r' || text[j] === '\n')) j++;
      if (j < text.length && (text[j] === '}' || text[j] === ']')) {
        continue;
      }
    }
    out.push(c);
  }
  var repaired = out.join('');
  try {
    return JSON.parse(repaired);
  } catch (e2) {
    if (fallback !== undefined) return fallback;
    throw e2;
  }
}

/**
 * 同音判定。這是 GAS 沒有拼音函式庫的替代方案，
 * 而且模型比拼音表更懂中文——它知道破音字、也知道整體詞感。
 *
 * 一定要批次做。先前是每一檔各發一次請求，一天二三十檔就是二三十次呼叫，
 * 連續打下來必然撞上每分鐘配額，實際就發生過整批 429 而讓工單失敗。
 * 現在把所有待判定的名稱包成一次請求，一天只花一次額度。
 *
 * items：pipeResolveName_ 回傳 pending 的那些，每個含 name 與 candidates。
 * 回傳 { 名稱: {code, name, how} }
 */
function pipeHomophoneBatch_(items, map) {
  var out = {};
  if (!items || !items.length) { return out; }

  // 候選清單每檔取前 25 個就夠，太多會把輸入撐得很大。
  var lines = items.map(function (it, i) {
    var cands = (it.candidates || []).slice(0, 25).map(function (x) {
      return x.c + ' ' + x.n;
    }).join('、');
    return (i + 1) + '. 聽到的名稱：' + it.name + '\n   候選：' + (cands || '（無）');
  }).join('\n\n');

  var raw;
  try {
    raw = callGemini_(PIPE_HOMOPHONE_SYSTEM, lines,
      { maxOut: 4096, temperature: 0, json: true });
  } catch (e) {
    Logger.log('  同音判定失敗（全部留待確認）：' + String(e).slice(0, 160));
    return out;
  }

  var res = safeParseJson_(raw, null);
  if (!res) return out;

  (res.results || []).forEach(function (r) {
    var key = String(r.input || '').trim();
    var code = String(r.code || '').trim();
    // 模型給的代號一定要真的在對照表裡才採用。這一道不能省，
    // 它是「模型只能選不能編」這條規則的實際執行點。
    if (key && code && map.byCode[code]) {
      out[key] = { code: code, name: map.byCode[code].name,
                   how: '同音判定：' + String(r.reason || '').slice(0, 30) };
    }
  });
  return out;
}


/* ------------------------------------------------------------------ *
 * 四、價位說明校對
 * ------------------------------------------------------------------ */

var PIPE_PRICE_NON_UNITS = ['億', '兆', '萬張', '張', '口', '點', '塊', '萬元', '千萬'];
var PIPE_PRICE_NON_WORDS = ['EPS', '每股', '年報', '財報', '營收', '毛利', '本益比',
                            '殖利率', '指數', '大盤', '成長', '均線', '月線', '季線', '年線'];

/** 數量金額單位只有緊接在數字後才算。否則「張震」的張、「重點」的點都會誤判。 */
function pipeHasNonPriceUnit_(s) {
  var t = String(s || '');
  for (var i = 0; i < PIPE_PRICE_NON_UNITS.length; i++) {
    var u = PIPE_PRICE_NON_UNITS[i], at = t.indexOf(u);
    while (at >= 0) {
      var k = at - 1;
      while (k >= 0 && (t.charAt(k) === ' ' || t.charAt(k) === '\u3000')) { k--; }
      if (k >= 0 && t.charAt(k) >= '0' && t.charAt(k) <= '9') { return true; }
      at = t.indexOf(u, at + 1);
    }
  }
  return false;
}

/**
 * 價位說明需不需要修。回傳原因，空字串代表沒問題。
 * 這一層是純規則的快篩，乾淨的列在這裡就通過了，不必送模型。
 */
function pipePriceSuspect_(direction, note) {
  var d = String(direction || '').trim();
  var s = String(note || '').trim();
  if (!s || s === '未說明') { return ''; }

  // 方向矛盾：買入那一列卻寫著賣出動作
  if (d.indexOf('買') === 0) {
    if (/賣|出清|全部出|獲利了結|停損/.test(s) && !/買|承接|進場|加碼/.test(s)) {
      return '方向是買入，但價位說明描述的是賣出';
    }
  } else if (d.indexOf('賣') === 0) {
    if (/買|承接|進場|加碼/.test(s) && !/賣|出清|出場|獲利了結|停損/.test(s)) {
      return '方向是賣出，但價位說明描述的是買入';
    }
  }

  for (var i = 0; i < PIPE_PRICE_NON_WORDS.length; i++) {
    if (s.indexOf(PIPE_PRICE_NON_WORDS[i]) >= 0) {
      return '含非股價用語「' + PIPE_PRICE_NON_WORDS[i] + '」';
    }
  }
  if (pipeHasNonPriceUnit_(s)) { return '含數量或金額單位，不是股價'; }
  if (/\d\s*(多|出頭)/.test(s)) { return '是概數，不能當成交價'; }
  if (s.length > 20) { return '價位說明過長，應濃縮'; }
  return '';
}

